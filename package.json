{
  "name": "aqardesk",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "bun --env-file=.env run turbo build",
    "dev": "bun --env-file=.env run turbo dev",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo typecheck",
    "db:generate": "bun --env-file=.env run --filter @workspace/database generate",
    "db:migrate": "bun --env-file=.env run --filter @workspace/database migrate",
    "db:studio": "bun --env-file=.env run --filter @workspace/database studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@workspace/typescript-config": "workspace:*",
    "turbo": "^2.11.10",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
