{
  "extends": "@aqardesk/typescript-config/nextjs.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": ["./src/*"],
      "@aqardesk/ui/cn": ["../../packages/ui/src/lib/utils.ts"],
      "@aqardesk/ui/globals.css": ["../../packages/ui/src/styles/globals.css"],
      "@aqardesk/ui/components/*": ["../../packages/ui/src/components/*"],
      "@aqardesk/ui/hooks/*": ["../../packages/ui/src/hooks/*"],
      "@aqardesk/ui/lib/*": ["../../packages/ui/src/lib/*"],
      "@aqardesk/ui/*": ["../../packages/ui/src/components/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/components/**",
    "src/hooks/**",
    "src/utils/**"
  ]
}
